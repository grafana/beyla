#!/usr/bin/env bash
#MISE alias="checkfmt"
#MISE description="Check Go formatting and imports"
set -euo pipefail
echo '### check correct formatting and imports'
check_format_value=${check_format-}
if [[ -n "${check_format_value//[[:space:]]/}" ]]; then
  echo "$check_format_value"
  echo "Above files are not properly formatted. Run 'mise run fmt' to fix them"
  exit 1
fi
