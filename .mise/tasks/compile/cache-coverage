#!/usr/bin/env bash
#MISE alias=["compile:cache-for-coverage", "compile-cache-for-coverage"]
#MISE description="Compile Beyla cache to generate coverage profiles"
set -euo pipefail

root=${MISE_CONFIG_ROOT:-$(git rev-parse --show-toplevel)}
cd "$root"

cmd=${CACHE_CMD-k8s-cache}
main_go_file=${CACHE_MAIN_GO_FILE-cmd/${cmd}/main.go}
goos=${GOOS-linux}
goarch=${GOARCH-amd64}

echo "### Compiling K8s cache service to generate coverage profiles"
CGO_ENABLED=0 GOOS="$goos" GOARCH="$goarch" go build -mod vendor -cover -a -o "bin/${cmd}" "$main_go_file"
