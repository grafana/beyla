#!/usr/bin/env bash
#MISE alias=["compile:for-coverage", "compile-for-coverage"]
#MISE description="Compile Beyla to generate coverage profiles"
set -euo pipefail

root=${MISE_CONFIG_ROOT:-$(git rev-parse --show-toplevel)}
cd "$root"

cmd=${CMD-beyla}
main_go_file=${MAIN_GO_FILE-cmd/${cmd}/main.go}
goos=${GOOS-linux}
goarch=${GOARCH-amd64}
buildinfo_pkg=${BUILDINFO_PKG-github.com/grafana/beyla/v3/pkg/buildinfo}
release_version=${RELEASE_VERSION-$(git describe --all 2>/dev/null | cut -d/ -f2 || true)}
release_revision=${RELEASE_REVISION-$(git rev-parse --short HEAD 2>/dev/null || true)}
version="test-${release_version}"
release_revision="test-${release_revision}"
ldflags="-X '${buildinfo_pkg}.Version=${version}' -X '${buildinfo_pkg}.Revision=${release_revision}'"

echo "### Compiling project to generate coverage profiles"
CGO_ENABLED=0 GOOS="$goos" GOARCH="$goarch" go build -mod vendor -ldflags="$ldflags" -cover -a -o "bin/${cmd}" "$main_go_file"
