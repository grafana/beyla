#!/usr/bin/env bash
#MISE alias=["docker:generate", "docker-generate"]
#MISE description="Generate OBI and Beyla eBPF code with the generator image"
#MISE depends=["submodule:obi"]
set -euo pipefail
root=${MISE_CONFIG_ROOT:-$(git rev-parse --show-toplevel)}
obi_module=${OBI_MODULE-$(awk '$1 == "replace" && $2 == "go.opentelemetry.io/obi" && $3 == "=>" { print $4; exit }' "$root/go.mod")}
oci_bin=$OCI_BIN
gen_img=${GEN_IMG:-ghcr.io/open-telemetry/obi-generator:$GEN_IMG_VERSION}
clang=${CLANG-clang}
if [[ -n "${CFLAGS-}" ]]; then
  bpf_cflags="-O2 -g -Wunaligned-access -Wpacked -Wpadded -Wall -Werror ${CFLAGS}"
else
  bpf_cflags="-O2 -g -Wunaligned-access -Wpacked -Wpadded -Wall -Werror"
fi
echo "### Generating files (submodule: $obi_module)"
(cd "$obi_module" && make docker-generate)
"$oci_bin" run --rm -u "$(id -u):$(id -g)" \
  -v "$root:/src:z" -v "$(cd "$obi_module" && pwd)/bpf:/obi-bpf:z" -w /src -e GOCACHE=/tmp/go-build \
  -e BPF2GO=/go/bin/bpf2go -e BPF_CLANG="$clang" -e BPF_CFLAGS="$bpf_cflags" \
  -e OBI_BPF_INCLUDE=/obi-bpf \
  --entrypoint /bin/sh "$gen_img" -c \
  'for llvm_bin in /usr/lib/llvm*/bin; do PATH="$llvm_bin:$PATH"; done; export PATH; GOOS=linux go generate ./pkg/internal/ebpf/surveywatcher'
