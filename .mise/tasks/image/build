#!/usr/bin/env bash
#MISE alias="image-build"
#MISE description="Build the Beyla auto-instrumenter image"
#MISE depends=["vendor:obi"]
set -euo pipefail
img_registry="${IMG_REGISTRY-docker.io}"
img_org="${IMG_ORG-grafana}"
img_name="${IMG_NAME-beyla}"
version="${VERSION-dev}"
gen_img="${GEN_IMG-ghcr.io/open-telemetry/obi-generator:$GEN_IMG_VERSION}"
img="${IMG-${img_registry}/${img_org}/${img_name}:${version}}"
oci_bin="$OCI_BIN"
if [[ -z "$img_org" ]]; then
  echo "Undefined IMG_ORG (Your Docker repository user name)" >&2
  exit 2
fi
echo "### Building the auto-instrumenter image"
"$oci_bin" buildx build --build-arg "GEN_IMG=$gen_img" --platform linux/amd64,linux/arm64 -t "$img" .
