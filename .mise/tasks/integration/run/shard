#!/usr/bin/env bash
#MISE description="Run one gotestsum integration-test shard"
set -euo pipefail

echo Partition
echo "${MATRIX_JSON}"

if [[ -z "${MATRIX_TEST_PATTERN:-}" ]]; then
  echo "Error: Test pattern is empty for shard ${MATRIX_ID:-}" >&2
  exit 1
fi

package="${1:?Integration shard package is required}"
shift

mkdir -p "${REPORT_DIR:-/home/runner/reports}"

gotestsum \
  --rerun-fails=2 --rerun-fails-max-failures=2 --rerun-fails-abort-on-data-race \
  "--packages=${package}" -ftestname \
  "--jsonfile=${REPORT_DIR:-/home/runner/reports}/test-run-${RUN_NUMBER}-${MATRIX_ID}.log" \
  -- \
  -count=1 "-tags=${TEST_TAGS}" -timeout 30m -mod vendor \
  "$@" "$package"
