#!/usr/bin/env bash
#MISE description="Collect a read-only release reconciliation report"
set -euo pipefail

: "${GH_TOKEN:=$(gh auth token 2>/dev/null || true)}"
export GH_TOKEN
if [[ -z "$GH_TOKEN" ]]; then
  echo "GH_TOKEN is required (or authenticate gh with gh auth login)." >&2
  exit 1
fi

if [[ -z "${REPOSITORY:-}" ]]; then
  REPOSITORY=$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null) || {
    echo "Set REPOSITORY or run inside a GitHub repository recognized by gh." >&2
    exit 1
  }
fi
export REPOSITORY
facts_dir=$(mktemp -d)
trap 'rm -rf "$facts_dir"' EXIT

fetch() {
  local filename=$1 endpoint=$2
  gh api "$endpoint" >"$facts_dir/$filename" 2>/dev/null || printf 'invalid response' >"$facts_dir/$filename"
}
fetch candidate.json "repos/${REPOSITORY}/commits/main"
if candidate_sha=$(jq -er '.sha | select(type == "string" and test("^[0-9a-fA-F]{40}$"))' "$facts_dir/candidate.json"); then
  fetch obi.json "repos/${REPOSITORY}/contents/.obi-src?ref=${candidate_sha}"
else
  # Missing/malformed candidate identity is unknown; never follow a moving ref.
  printf 'invalid response' >"$facts_dir/obi.json"
fi
gh api --paginate --slurp "repos/${REPOSITORY}/actions/workflows/release-train-prepare.yml/runs?per_page=100" >"$facts_dir/prepare-runs.json" 2>/dev/null || printf 'invalid response' >"$facts_dir/prepare-runs.json"
gh api --paginate --slurp "repos/${REPOSITORY}/actions/workflows/release-train-tag.yml/runs?per_page=100" >"$facts_dir/tag-runs.json" 2>/dev/null || printf 'invalid response' >"$facts_dir/tag-runs.json"
gh api --paginate --slurp "repos/${REPOSITORY}/releases?per_page=100" >"$facts_dir/releases.json" 2>/dev/null || printf 'invalid response' >"$facts_dir/releases.json"
gh api --paginate --slurp "repos/${REPOSITORY}/git/matching-refs/heads/release-" >"$facts_dir/beyla-refs.json" 2>/dev/null || printf 'invalid response' >"$facts_dir/beyla-refs.json"
gh api --paginate --slurp "repos/grafana/opentelemetry-ebpf-instrumentation/git/matching-refs/heads/release-" >"$facts_dir/obi-refs.json" 2>/dev/null || printf 'invalid response' >"$facts_dir/obi-refs.json"
FACTS_DIR="$facts_dir" python3 - <<'PY' >"$facts_dir/report.json"
import importlib.util
import json
import os
spec = importlib.util.spec_from_file_location("reconcile", "scripts/release-reconciliation/observer/report.py")
helper = importlib.util.module_from_spec(spec)
spec.loader.exec_module(helper)
facts = helper.load_facts(os.environ["FACTS_DIR"], os.environ["REPOSITORY"])
print(json.dumps(helper.report(facts), indent=2, sort_keys=True))
PY

printf '%s\n' BEGIN_RELEASE_RECONCILIATION_REPORT
cat "$facts_dir/report.json"
printf '%s\n' END_RELEASE_RECONCILIATION_REPORT
if [[ -n "${GITHUB_STEP_SUMMARY:-}" ]]; then
  {
    echo "## Read-only release reconciliation"
    echo '```json'
    cat "$facts_dir/report.json"
    echo '```'
  } >>"$GITHUB_STEP_SUMMARY"
fi
