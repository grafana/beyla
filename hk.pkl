// Keep check selection in hk while Mise owns tool versions.
amends "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Builtins.pkl"
import "package://github.com/jdx/hk/releases/download/v2.11.1/hk@2.11.1#/Config.pkl"

// These trees are generated or managed by another repository/tool.
exclude = List(".obi-src/**", "vendor/**", "internal/testgenerated/**")

steps {
  ["golangci-lint"] = (Builtins.golangci_lint) {
    // Beyla's existing root-module lint task has a six-minute timeout. Keep
    // the builtin scoped to this module instead of nested Go modules.
    workspace_indicator = null
    dir = "."
    // Configuration and module dependency edits can affect every package.
    glob = List("**/*.go", ".golangci.yml", "go.mod", "go.sum")
    check = new Config.CommandSpec {
      command = "golangci-lint run --fix=false ./... --timeout=6m"
      effect = "write"
    }
    depends = List("go-format")
    // Formatting is handled by the go-format step; lint checks remain
    // non-mutating in hk fix/pre-commit mode.
    fix = null
  }
  ["shellcheck"] = Builtins.shellcheck
  // Preserve the repository's established two-space shell indentation.
  ["shfmt"] = (Builtins.shfmt) {
    check_diff = new Config.CommandSpec {
      command = "shfmt -d -i 2 --apply-ignore {{files}}"
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = "shfmt -w -i 2 --apply-ignore {{files}}"
      effect = "write"
    }
  }
  ["go-format"] = new Config.Step {
    glob = "**/*.go"
    dir = "."
    // This uses the repository's golangci formatter configuration, including
    // the gci import sections in .golangci.yml.
    check_diff = new Config.CommandSpec {
      command = "golangci-lint fmt --diff {{files}}"
      effect = "read"
    }
    fix = new Config.CommandSpec {
      command = "golangci-lint fmt {{files}}"
      effect = "write"
    }
  }
  ["go-format-config"] = new Config.Step {
    glob = ".golangci.yml"
    dir = "."
    depends = List("go-format")
    // A formatter configuration change must re-check all Go source, not just
    // the YAML file that triggered this step.
    check_diff = new Config.CommandSpec {
      command = "golangci-lint fmt --diff"
      effect = "read"
    }
  }
  ["clang-format"] = (Builtins.clang_format) {
    // Keep C/C++ formatting fix-only, matching the existing hook policy.
    glob = List("**/*.c", "**/*.cpp", "**/*.h")
    check = null
  }
  ["clang-tidy"] = new Config.Step {
    // Preserve the existing task's BPF source/header scope; bpfcore is generated.
    glob = List("bpf/**/*.c", "bpf/**/*.h")
    exclude = List("bpf/bpfcore/**")
    dir = "."
    check = new Config.CommandSpec {
      command = "clang-tidy {{files}}"
      effect = "read"
    }
  }
}

hooks {
  ["pre-commit"] {
    stash = "git"
  }
}
