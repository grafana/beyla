#!/usr/bin/env bash
#MISE description="Clean Java agent build artifacts"
set -euo pipefail

project_dir="${MISE_MONOREPO_ROOT:-$(git -C "${MISE_CONFIG_ROOT:-$PWD}" rev-parse --show-toplevel)}"
cd "$project_dir"
echo "### Cleaning Java agent build artifacts"
gradle -p "$project_dir/.obi-src/pkg/internal/java" clean
