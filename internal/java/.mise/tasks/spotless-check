#!/usr/bin/env bash
#MISE description="Check Java code formatting"
set -euo pipefail

project_dir="${MISE_MONOREPO_ROOT:-$(git -C "${MISE_CONFIG_ROOT:-$PWD}" rev-parse --show-toplevel)}"
java_agent_dir=".obi-src/pkg/internal/java"
java_agent_patch_dir="internal/java"

cd "$project_dir"
echo "### Checking Java code formatting"
cp -r "$java_agent_patch_dir/agent" "$java_agent_dir/"
gradle -p "$project_dir/$java_agent_dir" spotlessCheck
