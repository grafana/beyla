#!/bin/sh
set -e
P=${BEYLA_PACKAGE_ROOT:-}
case "$1" in
  configure)
    if [ -f "$P/var/lib/grafana-beyla-sdk/mode" ]; then
      echo "beyla: prior experimental package state found in /var/lib/grafana-beyla-sdk; automatic migration is unsupported, and the existing configuration has been left untouched" >&2
      exit 1
    fi
    if [ "${BEYLA_TEST_NO_DEBCONF:-0}" != 1 ]; then
      . "$P/usr/share/debconf/confmodule"
      db_get beyla/mode; export BEYLA_SDK_MODE="$RET"
      db_get beyla/fleet-enabled; export BEYLA_FLEET_ENABLED="$RET"
      case "$BEYLA_FLEET_ENABLED" in
        true|yes|1)
          db_get beyla/fleet-url; export GRAFANA_CLOUD_FLEET_URL="$RET"
          db_get beyla/fleet-instance-id; export GRAFANA_CLOUD_FLEET_INSTANCE_ID="$RET"
          ;;
        *)
          unset GRAFANA_CLOUD_FLEET_URL GRAFANA_CLOUD_FLEET_INSTANCE_ID
          ;;
      esac
      db_get beyla/otlp-endpoint; export GRAFANA_CLOUD_OTLP_ENDPOINT="$RET"
      db_get beyla/otlp-tenant; export GRAFANA_CLOUD_OTLP_TENANT_ID="$RET"
      db_get beyla/otlp-token; export GRAFANA_CLOUD_OTLP_TOKEN="$RET"
      db_get beyla/metrics-endpoint; export GRAFANA_CLOUD_METRICS_ENDPOINT="$RET"
      db_get beyla/metrics-tenant; export GRAFANA_CLOUD_METRICS_TENANT_ID="$RET"
      db_get beyla/metrics-token; export GRAFANA_CLOUD_METRICS_TOKEN="$RET"
      db_get beyla/profiles-endpoint; export GRAFANA_CLOUD_PROFILES_ENDPOINT="$RET"
      db_get beyla/profiles-tenant; export GRAFANA_CLOUD_PROFILES_TENANT_ID="$RET"
      db_get beyla/profiles-token; export GRAFANA_CLOUD_PROFILES_TOKEN="$RET"
      db_get beyla/services; export BEYLA_SDK_SERVICES="$RET"
      db_get beyla/open-ports; export BEYLA_OPEN_PORTS="$RET"
    fi
    case "${BEYLA_FLEET_ENABLED:-false}" in
      true|yes|1) ;;
      *)
        BEYLA_FLEET_ENABLED=false
        unset GRAFANA_CLOUD_FLEET_URL GRAFANA_CLOUD_FLEET_INSTANCE_ID
        ;;
    esac

    # Preserve customer-owned config. Only accept the pristine Alloy package
    # defaults on first installation.
    if [ ! -f "$P/var/lib/beyla/mode" ]; then
      if [ -f "$P/etc/default/alloy" ] && grep -Ev '^[[:space:]]*(#.*)?$|^(CONFIG_FILE="/etc/alloy/config.alloy"|OTEL_CONFIG_FILE="/etc/alloy/config.yaml"|CUSTOM_ARGS=""|OTEL_CUSTOM_ARGS=""|ALLOY_OTEL_MODE=""|RESTART_ON_UPGRADE=true)$' "$P/etc/default/alloy" | grep -q .; then
        echo "beyla: custom Alloy settings in /etc/default/alloy are unsupported; refusing to replace them" >&2
        exit 1
      fi
      installed_hash=$(dpkg-query -W -f='${Conffiles}\n' alloy 2>/dev/null | awk '$1 == "/etc/alloy/config.alloy" {print $2}')
      actual_hash=$(md5sum "$P/etc/alloy/config.alloy" 2>/dev/null | awk '{print $1}')
      if [ -z "$installed_hash" ] || [ "$installed_hash" != "$actual_hash" ]; then
        echo "beyla: /etc/alloy/config.alloy differs from the installed Alloy default; refusing to replace it" >&2
        exit 1
      fi
      if [ -d "$P/etc/systemd/system/alloy.service.d" ] && find "$P/etc/systemd/system/alloy.service.d" -type f -print -quit | grep -q .; then
        echo "beyla: existing Alloy drop-ins are unsupported; refusing to override them" >&2
        exit 1
      fi
    fi

    if [ ! -f "$P/var/lib/beyla/mode" ]; then
      if [ -n "$P" ]; then
        install -d -m 0755 "$P/etc/beyla" "$P/var/lib/beyla"
      else
        install -d -o root -g root -m 0755 /etc/beyla /var/lib/beyla
      fi
      if [ -e "$P/etc/beyla/alloy.env" ] || [ -e "$P/etc/beyla/config.alloy" ]; then
        echo "beyla: unmarked pre-existing config found; refusing to overwrite it" >&2
        exit 1
      fi
      install -m 0644 "$P/usr/share/beyla/config.alloy" "$P/etc/beyla/config.alloy"
      if ! BEYLA_PACKAGE_ROOT="$P" python3 "$P/usr/lib/beyla/configure.py"; then
        # configure.py checks the complete input and selected service units
        # before creating the durable 0600 environment file or state marker.
        # Remove only the exact template copied by this postinst so a corrected
        # retry can proceed; never delete a user-modified config.
        if [ ! -e "$P/var/lib/beyla/mode" ] && \
          [ ! -e "$P/etc/beyla/alloy.env" ] && \
          cmp -s "$P/usr/share/beyla/config.alloy" "$P/etc/beyla/config.alloy"; then
          rm -f "$P/etc/beyla/config.alloy"
        fi
        exit 1
      fi
      # Password fields are no longer needed after the durable 0600 files have
      # been written. Do not keep a second plaintext token copy in debconf.
      if [ "${BEYLA_TEST_NO_DEBCONF:-0}" != 1 ]; then
        db_set beyla/otlp-token ""
        db_set beyla/metrics-token ""
        db_set beyla/profiles-token ""
      fi
    else
      if [ "$(cat "$P/var/lib/beyla/mode")" != "$BEYLA_SDK_MODE" ]; then
        echo "beyla: changing instrumentation mode after install is unsupported; preserving existing configuration" >&2
        exit 1
      fi
    fi
    BEYLA_PACKAGE_ROOT="$P" python3 "$P/usr/lib/beyla/validate-alloy.py"
    alloy_dropin="$P/etc/systemd/system/alloy.service.d/50-beyla.conf"
    if [ -e "$alloy_dropin" ]; then
      if ! cmp -s "$P/usr/share/beyla/alloy-service-dropin.conf" "$alloy_dropin"; then
        echo "beyla: preserving modified Alloy drop-in; refusing to overwrite it" >&2
        exit 1
      fi
    else
      if [ -n "$P" ]; then
        install -d -m 0755 "$P/etc/systemd/system/alloy.service.d"
      else
        install -d -o root -g root -m 0755 /etc/systemd/system/alloy.service.d
      fi
      install -m 0644 "$P/usr/share/beyla/alloy-service-dropin.conf" "$alloy_dropin"
    fi
    systemctl daemon-reload
    systemctl enable alloy.service
    if systemctl is-active --quiet alloy.service; then
      systemctl restart alloy.service
    else
      systemctl start alloy.service
    fi
    ;;
esac
exit 0
